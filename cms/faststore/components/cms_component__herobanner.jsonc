{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "HeroBanner",
  "$componentTitle": "[ARB] Hero Banner",
  "title": "[ARB] Hero Banner",
  "description": "Full-width promo banner with image, headline stack, and CTA",
  "type": "object",
  "required": [],
  "properties": {
    "desktopImage": {
      "title": "Desktop Image",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": {
          "video": true,
          "image": ["png", "jpg", "jpeg", "gif", "svg", "webp"]
        }
      }
    },
    "mobileImage": {
      "title": "Mobile Image",
      "type": "string",
      "widget": {
        "ui:widget": "media-gallery",
        "restrictMediaTypes": {
          "video": true,
          "image": ["png", "jpg", "jpeg", "gif", "svg", "webp"]
        }
      }
    },
    "imageAlt": {
      "title": "Image Alt Text",
      "type": "string"
    },
    "backgroundColor": {
      "title": "Background Color (hex)",
      "type": "string",
      "default": "#efefef"
    },
    "textColor": {
      "title": "Text Color (hex)",
      "type": "string",
      "default": "#252525"
    },
    "contentPosition": {
      "title": "Content Position",
      "type": "string",
      "enum": ["left", "center", "right"],
      "default": "center"
    },
    "eyebrow": {
      "title": "Eyebrow (small text above headline)",
      "type": "string"
    },
    "headline": {
      "title": "Headline",
      "type": "string"
    },
    "subheadline": {
      "title": "Subheadline",
      "type": "string"
    },
    "text": {
      "title": "Body Text",
      "type": "string"
    },
    "cta": {
      "title": "Call to Action",
      "type": "object",
      "properties": {
        "url": {
          "title": "Link URL",
          "type": "string"
        },
        "text": {
          "title": "Button Label",
          "type": "string"
        },
        "colorScheme": {
          "title": "Button Color Scheme",
          "type": "string",
          "enum": ["white", "green", "whiteOutline"],
          "default": "white"
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}
