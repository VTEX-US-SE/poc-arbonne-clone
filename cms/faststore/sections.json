          "title": "Text Color (hex)",
          "type": "string",
          "default": "#252525"
        },
        "cards": {
          "title": "Cards",
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "Card",
            "type": "object",
            "properties": {
              "image": {
                "title": "Image",
                "type": "string",
                "widget": {
                  "ui:widget": "media-gallery"
                }
              },
              "imageAlt": {
                "title": "Image Alt Text",
                "type": "string"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "subtitle": {
                "title": "Subtitle",
                "type": "string"
              },
              "description": {
                "title": "Description",
                "type": "string"
              },
              "link": {
                "title": "Link",
                "type": "object",
                "properties": {
                  "url": {
                    "title": "Link URL",
                    "type": "string"
                  },
                  "text": {
                    "title": "Link Text",
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
