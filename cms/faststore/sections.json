          "type": "string"
        },
        "imagePosition": {
          "title": "Image Position",
          "type": "string",
          "enum": ["left", "right"],
          "default": "left"
        },
        "textAlign": {
          "title": "Text Alignment",
          "type": "string",
          "enum": ["start", "center"],
          "default": "center"
        },
        "eyebrow": {
          "title": "Eyebrow (small text above headline)",
          "type": "string"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "text": {
          "title": "Body Text",
          "type": "string"
        },
        "link": {
          "title": "Link (rendered on its own line below Body Text, e.g. \"EARNINGS.ARBONNE.COM.\")",
          "type": "object",
