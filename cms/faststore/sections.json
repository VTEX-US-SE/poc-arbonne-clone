[
  {
    "name": "HeroBanner",
    "scopes": ["global"],
    "schema": {
      "title": "[ARB] Hero Banner",
      "description": "Full-width promo banner with image, headline stack, and CTA",
      "type": "object",
      "required": [],
      "properties": {
        "desktopImage": {
          "title": "Desktop Image",
          "type": "string",
          "widget": {
            "ui:widget": "media-gallery"
          }
        },
        "mobileImage": {
          "title": "Mobile Image",
          "type": "string",
          "widget": {
            "ui:widget": "media-gallery"
          }
        },
        "imageAlt": {
          "title": "Image Alt Text",
          "type": "string"
        },
        "backgroundColor": {
          "title": "Background Color (hex)",
          "type": "string",
          "default": "#efefef"
        },
        "contentPosition": {
          "title": "Content Position",
          "type": "string",
          "enum": ["left", "center", "right"],
          "default": "center"
        },
        "eyebrow": {
          "title": "Eyebrow (small text above headline)",
          "type": "string"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "subheadline": {
          "title": "Subheadline",
          "type": "string"
        },
        "text": {
          "title": "Body Text",
          "type": "string"
        },
        "cta": {
          "title": "Call to Action",
          "type": "object",
          "properties": {
            "url": {
              "title": "Link URL",
              "type": "string"
            },
            "text": {
              "title": "Button Label",
              "type": "string"
            },
            "colorScheme": {
              "title": "Button Color Scheme",
              "type": "string",
              "enum": ["white", "whiteOutline"],
              "default": "white"
            }
          }
        }
      }
    }
  },
  {
    "name": "ImageTextSplit",
    "scopes": ["global"],
    "schema": {
      "title": "[ARB] Image/Text Split",
      "description": "Two-column layout with an image on one side and a text block on the other",
      "type": "object",
      "required": [],
      "properties": {
        "image": {
          "title": "Image",
          "type": "string",
          "widget": {
            "ui:widget": "media-gallery"
          }
        },
        "imageAlt": {
          "title": "Image Alt Text",
          "type": "string"
        },
        "imagePosition": {
          "title": "Image Position",
          "type": "string",
          "enum": ["left", "right"],
          "default": "left"
        },
        "textAlign": {
          "title": "Text Alignment",
          "type": "string",
          "enum": ["start", "center"],
          "default": "center"
        },
        "eyebrow": {
          "title": "Eyebrow (small text above headline)",
          "type": "string"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "text": {
          "title": "Body Text",
          "type": "string"
        },
        "link": {
          "title": "Link (rendered on its own line below Body Text, e.g. \"EARNINGS.ARBONNE.COM.\")",
          "type": "object",
          "properties": {
            "url": {
              "title": "Link URL",
              "type": "string"
            },
            "text": {
              "title": "Link Text",
              "type": "string"
            }
          }
        },
        "cta": {
          "title": "Call to Action",
          "type": "object",
          "properties": {
            "url": {
              "title": "Link URL",
              "type": "string"
            },
            "text": {
              "title": "Button Label",
              "type": "string"
            },
            "colorScheme": {
              "title": "Button Color Scheme",
              "type": "string",
              "enum": ["white", "whiteOutline"],
              "default": "whiteOutline"
            }
          }
        }
      }
    }
  }
]
