[
  {
    "name": "HeroBanner",
    "scopes": ["global"],
    "schema": {
      "title": "[ARB] Hero Banner",
      "description": "Full-width promo banner with image, headline stack, and CTA",
      "type": "object",
      "required": [],
      "properties": {
        "desktopImage": {
          "title": "Desktop Image",
          "type": "string",
