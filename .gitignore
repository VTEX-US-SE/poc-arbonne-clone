# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# WebOps deprecated this for production use -- configure secrets/build
# settings directly in FastStore WebOps Settings instead. Local-dev only.
vtex.env

# vercel
.vercel

# typescript
*.tsbuildinfo

# faststore
/.faststore
.vscode/
lighthouserc.js

# Build output copied into `public/`. These ship in `@faststore/core/public`
# (plus the Partytown lib) and every `yarn build` recreates them, so they are
# never ours to commit. Named individually rather than ignoring `/public`, which
# also holds real assets -- favicon, flags, fonts.
/public/~partytown/
/public/brandless-negative.png
/public/brandless-neutral.png
/public/brandless-positive.png
/public/icons.svg
/public/logo.svg
/public/mockServiceWorker.js

# local Weni CLI (do not commit)
/venv
