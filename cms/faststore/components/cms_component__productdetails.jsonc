{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "ProductDetails",
  "$componentTitle": "[ARB] Product Details",
  "title": "[ARB] Product Details",
  "description": "PDP gallery, price, add-to-cart and product description",
  "type": "object",
  "required": [],
  "properties": {
    "refIdSuffix": {
      "title": "Reference Code Suffix",
      "type": "string",
      "default": "US"
    },
    "sizePropertyName": {
      "title": "Pack Size Property",
      "description": "Product specification holding the pack size, e.g. Volume",
      "type": "string",
      "default": "Volume"
    },
    "priceLabel": {
      "title": "Price Label",
      "type": "string",
      "default": "YOUR PRICE"
    },
    "quantityLabel": {
      "title": "Quantity Label",
      "type": "string",
      "default": "Quantity"
    },
    "addToCartLabel": {
      "title": "Add to Cart Label",
      "type": "string",
      "default": "Add to Cart"
    },
    "replenishCtaLabel": {
      "title": "Subscription Button Label",
      "type": "string",
      "default": "Add to ReplenishMe"
    },
    "instalmentsText": {
      "title": "Instalments Text",
      "type": "string"
    },
    "oneTimeLabel": {
      "title": "One-time Purchase Label",
      "type": "string",
      "default": "One-time purchase"
    },
    "replenishTitle": {
      "title": "Subscription Title",
      "type": "string"
    },
    "replenishText": {
      "title": "Subscription Description",
      "type": "string",
      "widget": {
        "ui:widget": "draftjs-rich-text"
      }
    },
    "replenishFrequencies": {
      "title": "Delivery Frequencies",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": {
            "title": "Value",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}
