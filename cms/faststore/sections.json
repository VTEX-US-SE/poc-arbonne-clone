            "url": {
              "title": "Link URL",
              "type": "string"
            },
            "text": {
              "title": "Link Text",
              "type": "string"
            }
          }
        },
        "cta": {
          "title": "Call to Action",
          "type": "object",
          "properties": {
            "url": {
              "title": "Link URL",
              "type": "string"
            },
            "text": {
              "title": "Button Label",
              "type": "string"
            },
            "colorScheme": {
              "title": "Button Color Scheme",
              "type": "string",
